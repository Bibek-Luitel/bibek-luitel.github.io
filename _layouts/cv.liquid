---
layout: default
---

<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}
      {% if page.cv_pdf %}
        <a href="{{ page.cv_pdf | prepend: 'assets/pdf/' | relative_url }}" target="_blank" rel="noopener noreferrer" class="float-right">
          <i class="fa-solid fa-file-pdf"></i>
        </a>
      {% endif %}
    </h1>
    {% if page.description %}<p class="post-description">{{ page.description }}</p>{% endif %}
  </header>

  <article>
    <div class="cv">
      {% if site.data.resume %}
        {% comment %} 
          This loop FORCES the order based on your config.yml list
        {% endcomment %}
        {% for section in site.jsonresume %}
          {% assign section_exists = site.data.resume[section] %}
          
          {% if section_exists %}
            <a class="anchor" id="{{ section }}"></a>
            <div class="card mt-3 p-3">
              <h3 class="card-title font-weight-medium">{{ section | capitalize }}</h3>
              <div>
                {% if section == 'basics' %}
                  {% include resume/basics.liquid %}
                {% elsif section == 'education' %}
                  {% include resume/education.liquid %}
                {% elsif section == 'work' %}
                  {% include resume/work.liquid %}
                {% elsif section == 'publications' %}
                  {% include resume/publications.liquid %}
                {% elsif section == 'projects' %}
                  {% include resume/projects.liquid %}
                {% elsif section == 'awards' %}
                  {% include resume/awards.liquid %}
                {% elsif section == 'skills' %}
                  {% include resume/skills.liquid %}
                {% elsif section == 'languages' %}
                  {% include resume/languages.liquid %}
                {% elsif section == 'interests' %}
                  {% include resume/interests.liquid %}
                {% elsif section == 'references' %}
                  {% include resume/references.liquid %}
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      {% endif %}
    </div>
  </article>
</div>