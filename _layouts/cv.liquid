---
layout: default
---

<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {{ page.title }}
      {% if page.cv_pdf %}
        <a
          {% if page.cv_pdf contains '://' %}
            href="{{ page.cv_pdf }}"
          {% else %}
            href="{{ page.cv_pdf | prepend: 'assets/pdf/' | relative_url }}"
          {% endif %}
          target="_blank"
          rel="noopener noreferrer"
          class="float-right"
        >
          <i class="fa-solid fa-file-pdf"></i>
        </a>
      {% endif %}
    </h1>
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  <article>
    <div class="cv">
      {% assign resume = site.data.resume %}

      {% comment %}
      Render each section if it exists
      {% endcomment %}

      {% if resume.basics %}
        <a class="anchor" id="basics"></a>
        <div class="card mt-3 p-3">
          <h3 class="card-title font-weight-medium">Basics</h3>
          {% include resume/basics.liquid section=resume.basics %}
        </div>
      {% endif %}

      {% if resume.education %}
        <a class="anchor" id="education"></a>
        <div class="card mt-3 p-3">
          <h3 class="card-title font-weight-medium">Education</h3>
          {% include resume/education.liquid section=resume.education %}
        </div>
      {% endif %}

      {% if resume.work %}
        <a class="anchor" id="work"></a>
        <div class="card mt-3 p-3">
          <h3 class="card-title font-weight-medium">Work</h3>
          {% include resume/work.liquid section=resume.work %}
        </div>
      {% endif %}

      {% if resume.volunteer %}
        <a class="anchor" id="volunteer"></a>
        <div class="card mt-3 p-3">
          <h3 class="card-title font-weight-medium">Volunteer</h3>
          {% include resume/volunteer.liquid section=resume.volunteer %}
        </div>
      {% endif %}

      {% if resume.projects %}
        <a class="anchor" id="projects"></a>
        <div class="card mt-3 p-3">
          <h3 class="card-title font-weight-medium">Projects</h3>
          {% include resume/projects.liquid section=resume.projects %}
        </div>
      {% endif %}

      {% if resume.skills %}
        <a class="anchor" id="skills"></a>
        <div class="card mt-3 p-3">
          <h3 class="card-title font-weight-medium">Skills</h3>
          {% include resume/skills.liquid section=resume.skills %}
        </div>
      {% endif %}

      {% if resume.awards %}
        <a class="anchor" id="awards"></a>
        <div class="card mt-3 p-3">
          <h3 class="card-title font-weight-medium">Awards</h3>
          {% include resume/awards.liquid section=resume.awards %}
        </div>
      {% endif %}

      {% if resume.publications %}
        <a class="anchor" id="publications"></a>
        <div class="card mt-3 p-3">
          <h3 class="card-title font-weight-medium">Publications</h3>
          {% include resume/publications.liquid section=resume.publications %}
        </div>
      {% endif %}

      {% if resume.languages %}
        <a class="anchor" id="languages"></a>
        <div class="card mt-3 p-3">
          <h3 class="card-title font-weight-medium">Languages</h3>
          {% include resume/languages.liquid section=resume.languages %}
        </div>
      {% endif %}

      {% if resume.interests %}
        <a class="anchor" id="interests"></a>
        <div class="card mt-3 p-3">
          <h3 class="card-title font-weight-medium">Interests</h3>
          {% include resume/interests.liquid section=resume.interests %}
        </div>
      {% endif %}

      {% if resume.certificates %}
        <a class="anchor" id="certificates"></a>
        <div class="card mt-3 p-3">
          <h3 class="card-title font-weight-medium">Certificates</h3>
          {% include resume/certificates.liquid section=resume.certificates %}
        </div>
      {% endif %}

      {% if resume.references %}
        <a class="anchor" id="references"></a>
        <div class="card mt-3 p-3">
          <h3 class="card-title font-weight-medium">References</h3>
          {% include resume/references.liquid section=resume.references %}
        </div>
      {% endif %}

    </div>
  </article>
</div>

