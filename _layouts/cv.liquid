---
layout: default
---

<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {{ page.title }}
      {% if page.cv_pdf %}
        <a
          {% if page.cv_pdf contains '://' %}
            href="{{ page.cv_pdf }}"
          {% else %}
            href="{{ page.cv_pdf | prepend: 'assets/pdf/' | relative_url }}"
          {% endif %}
          target="_blank"
          rel="noopener noreferrer"
          class="float-right"
        >
          <i class="fa-solid fa-file-pdf"></i>
        </a>
      {% endif %}
    </h1>
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  <article>
    <div class="cv">

      {% if site.data.resume %}
        {% for section_name, content in site.data.resume %}
          {% if content == nil or content.size == 0 %}
            {% continue %}
          {% endif %}
          <a class="anchor" id="{{ section_name | slugify }}"></a>
          <div class="card mt-3 p-3">
            <h3 class="card-title font-weight-medium">{{ section_name | capitalize }}</h3>
            <div>
              {% case section_name %}
                {% when 'basics' %}
                  {% include resume/basics.liquid section=content %}
                {% when 'education' %}
                  {% include resume/education.liquid section=content %}
                {% when 'work' %}
                  {% include resume/work.liquid section=content %}
                {% when 'volunteer' %}
                  {% include resume/volunteer.liquid section=content %}
                {% when 'projects' %}
                  {% include resume/projects.liquid section=content %}
                {% when 'awards' %}
                  {% include resume/awards.liquid section=content %}
                {% when 'skills' %}
                  {% include resume/skills.liquid section=content %}
                {% when 'publications' %}
                  {% include resume/publications.liquid section=content %}
                {% when 'languages' %}
                  {% include resume/languages.liquid section=content %}
                {% when 'interests' %}
                  {% include resume/interests.liquid section=content %}
                {% when 'certificates' %}
                  {% include resume/certificates.liquid section=content %}
                {% when 'references' %}
                  {% include resume/references.liquid section=content %}
              {% endcase %}
            </div>
          </div>
        {% endfor %}
      {% endif %}

    </div>
  </article>
</div>

