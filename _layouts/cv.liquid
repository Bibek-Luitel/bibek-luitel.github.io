---
layout: default
---

<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}
      {% if page.cv_pdf %}
        <a href="{{ page.cv_pdf | prepend: 'assets/pdf/' | relative_url }}" target="_blank" rel="noopener noreferrer" class="float-right">
          <i class="fa-solid fa-file-pdf"></i>
        </a>
      {% endif %}
    </h1>
    {% if page.description %}<p class="post-description">{{ page.description }}</p>{% endif %}
  </header>

  <article>
    <div class="cv">
      {% if site.data.resume %}
        {% comment %} 
          This loop specifically uses the order defined in _config.yml
        {% endcomment %}
        {% for section_name in site.jsonresume %}
          {% assign section_data = site.data.resume[section_name] %}
          
          {% comment %} Skip if there is no data for this specific section {% endcomment %}
          {% if section_data == null or section_data.size == 0 %}{% continue %}{% endif %}

          <a class="anchor" id="{{ section_name }}"></a>
          <div class="card mt-3 p-3">
            <h3 class="card-title font-weight-medium">{{ section_name | capitalize }}</h3>
            <div>
              {% case section_name %}
                {% when 'basics' %}{% include resume/basics.liquid %}
                {% when 'education' %}{% include resume/education.liquid %}
                {% when 'work' %}{% include resume/work.liquid %}
                {% when 'publications' %}{% include resume/publications.liquid %}
                {% when 'projects' %}{% include resume/projects.liquid %}
                {% when 'awards' %}{% include resume/awards.liquid %}
                {% when 'skills' %}{% include resume/skills.liquid %}
                {% when 'volunteer' %}{% include resume/volunteer.liquid %}
                {% when 'certificates' %}{% include resume/certificates.liquid %}
                {% when 'languages' %}{% include resume/languages.liquid %}
                {% when 'interests' %}{% include resume/interests.liquid %}
                {% when 'references' %}{% include resume/references.liquid %}
              {% endcase %}
            </div>
          </div>
        {% endfor %}
      {% else %}
        {% comment %} Fallback for standard cv.yml format {% endcomment %}
        {% for entry in site.data.cv %}
          <div class="card mt-3 p-3">
            <h3 class="card-title font-weight-medium">{{ entry.title }}</h3>
            {% include cv/time_table.liquid %}
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </article>
</div>